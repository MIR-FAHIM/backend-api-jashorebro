<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive configuration files
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml) - [F,L]

    # Forward root requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Force ea-php82 for cPanel EasyApache
<IfModule mime_module>
    AddHandler application/x-httpd-ea-php82 .php
</IfModule>
